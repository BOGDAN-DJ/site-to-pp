#!/bin/sh
# Управление туннелем CSQTT физическим переключателем роутера.
#
# Ставится в /etc/rc.button/BTN_0 — на Cudy TR3000 это переключатель "mode"
# (в devicetree gpio-keys/mode, linux,code = 0x100 = BTN_0). Кнопку reset
# намеренно не трогаем: она нужна для failsafe, и переопределять её —
# значит лишиться единственного способа вернуть роутер к жизни.
#
# Это именно ПЕРЕКЛЮЧАТЕЛЬ, а не кнопка: у него два устойчивых положения, и
# procd сообщает о переводе в каждое из них своим ACTION. Поэтому здесь не
# toggle, а прямое отображение "положение -> состояние":
#
#   pressed  (GPIO активен, линия low)  -> туннель включён
#   released (GPIO не активен, линия hi) -> туннель выключен
#
# Toggle для тумблера был бы неверен: одно направление вообще не вызывало бы
# обработчик, а второе переключало бы вслепую, и положение переключателя
# перестало бы соответствовать реальному состоянию. Прямое отображение ещё и
# идемпотентно — повторный вызов с тем же ACTION ничего не ломает.
#
# Переменную SEEN (сколько секунд удерживали) здесь не смотрим: для тумблера
# это время с прошлой смены положения, оно может быть каким угодно.

STATE_LED=/sys/class/leds/white:status

blink() {
	[ -d "$STATE_LED" ] || return 0
	n=$1
	while [ "$n" -gt 0 ]; do
		echo 1 > "$STATE_LED/brightness" 2>/dev/null
		usleep 120000
		echo 0 > "$STATE_LED/brightness" 2>/dev/null
		usleep 120000
		n=$((n - 1))
	done
}

api() {
	curl -s --max-time 120 -X POST "http://127.0.0.1:8080/api/$1" 2>/dev/null
}

case "$ACTION" in
	pressed)
		logger -t csqtt-button "переключатель: включаю туннель"
		RESP="$(api connect)"
		case "$RESP" in
			*'"success":true'*)
				logger -t csqtt-button "туннель включён"
				blink 2
				;;
			*'уже подключено'*)
				# Идемпотентность: состояние и так нужное, это не ошибка.
				logger -t csqtt-button "туннель уже был включён"
				blink 2
				;;
			*)
				logger -t csqtt-button "включить не удалось: ${RESP:-нет ответа от демона}"
				blink 5
				;;
		esac
		;;
	released)
		logger -t csqtt-button "переключатель: выключаю туннель"
		api disconnect >/dev/null
		logger -t csqtt-button "туннель выключен"
		blink 1
		;;
esac

exit 0
