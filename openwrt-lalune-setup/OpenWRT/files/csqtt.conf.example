# Пример /etc/csqtt/csqtt.conf для демона LaLune/CSQTT на OpenWrt.
# Скопируйте в /etc/csqtt/csqtt.conf и заполните значениями из вашей
# csqtt://connect?... ссылки (см. README.md, раздел "Формат ссылки").
#
# Обязательные поля: PEER, PASSWORD, VK.
# Остальные можно оставить как есть — это разумные значения по умолчанию,
# совпадающие с настройками Desktop-клиента LaLune.

PEER=''
PASSWORD=''
VK=''

N='18'
FINGERPRINT='chrome'
CLIENT_IDS=''
OBFS='video'
VK_AUTH_MODE='vkcalls'
DEVICE_ID='unknown'
CAPTCHA_MODE='auto'

# Необязательно: свой TURN-сервер вместо того, что придёт от сервера CSQTT.
TURN_HOST=''
TURN_PORT=''

# Имя TUN-интерфейса, который создаст демон.
TUN='csqtt0'

# Что делать при старте демона, то есть и после перезагрузки роутера:
#
#   '0'       ничего, ждать команды (по умолчанию)
#   '1'       всегда подключаться
#   'switch'  подключаться, только если аппаратный переключатель стоит
#             в положении "включено"
#
# Включать автозапуск имеет смысл, когда туннель уже проверен: пока стоит
# '0', перезагрузка гарантированно возвращает роутер в состояние без
# туннеля, и это самый простой способ всё починить. Маршрут WAN демон не
# удаляет в любом случае, так что даже неудачное автоподключение не
# оставит роутер без интернета.
AUTOCONNECT='0'

# Метка переключателя в devicetree для режима AUTOCONNECT='switch'.
# На Cudy TR3000 это 'mode' (gpio-keys/mode, linux,code 0x100 = BTN_0).
SWITCH_LABEL='mode'

# Индикация состояния туннеля штатным светодиодом. Имена из
# /sys/class/leds; пустое значение отключает соответствующую индикацию.
#
#   LED      мигает при подключении, ровно горит при поднятом туннеле
#   LED_IDLE горит, когда туннеля нет
#
# На Cudy TR3000 это два входа одного двухцветного индикатора, поэтому
# "туннеля нет" показывается красным, а не темнотой: погашенный светодиод
# выглядел бы так, будто роутер выключен.
#
# Исходное состояние обоих светодиодов демон запоминает при старте и
# возвращает при выходе.
LED='white:status'
LED_IDLE='red:power'

# Подсети, трафик которых заворачивается в туннель, через запятую.
# Пустое значение — определить автоматически по адресам LAN-интерфейса
# (network.lan.device из uci, обычно br-lan).
#
# Трафик самого роутера в туннель не попадает ни при каких настройках:
# ядру csqtt-client надо ходить на серверы авторизации VK, и если его
# запросы уходят в туннель, который он же и поднимает, получается
# замкнутый круг — упавший туннель не может подняться сам.
LAN_SUBNETS=''

# Адрес, на котором висят веб-панель и API.
#
# Пустое значение означает "взять LAN-адрес роутера автоматически".
# Loopback (127.0.0.1:8080) слушается всегда независимо от этой настройки —
# через него ходят скрипт переключателя и install.sh.
#
# Слушать все интерфейсы (':8080') не стоит: панель принимает и показывает
# параметры подключения, и от WAN её отделял бы только firewall.
LISTEN=''
